# Appwrite Public Configuration (Client & Server)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=your_appwrite_project_id
NEXT_PUBLIC_APPWRITE_DATABASE=your_appwrite_database_id
NEXT_PUBLIC_APPWRITE_MESSAGES_TABLE=your_appwrite_messages_table_id

# Appwrite Server API Key (Required for /api/users to list registered users)
# Must have 'users.read' scope
APPWRITE_API_KEY=your_appwrite_api_key
